# Gootiraa Research Hub — Environment Configuration Template
NODE_ENV=development
PORT=5000

# Database Connection (Supports SQLite for local zero-dependency development or PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL: DATABASE_URL="postgresql://gootiraa_user:secret_password@localhost:5432/gootiraa_db?schema=public"

# Authentication & Security
JWT_SECRET="gootiraa_dev_super_secret_jwt_key_at_least_32_characters_long_2026"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# External Scholarly API Integration (Optional Keys)
OPENALEX_EMAIL="contact@gootiraa.org"
OPENALEX_API_KEY=""
CROSSREF_MAILTO="contact@gootiraa.org"
SEMANTIC_SCHOLAR_API_KEY=""

# AI Research Assistant (Optional external provider key)
AI_PROVIDER="internal_grounded"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Upload and Storage Directory
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25
